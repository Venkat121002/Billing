rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All billing data (SwordNexBillingSoftware/{tenantId}/...) is read and
    // written only by the backend through the Firebase Admin SDK, which is not
    // subject to these rules. The web app never talks to Firestore directly.
    //
    // So no client gets any access. Allowing an owner to write their own tree
    // let them edit their own store record (e.g. set their subscription to
    // Premium) and let staff edit their own staff record straight from a
    // browser with the public web API key, bypassing every server-side check.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
