rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow any authenticated user to read/write to all collections
    // This is temporary to verify the fix and unblock the user.
    // Ideally, we should restrict by tenant or user ID.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}
