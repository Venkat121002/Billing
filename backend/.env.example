# Copy to .env.custom and fill in. .env.custom is git-ignored.

# Database — MongoDB only for now.
DB_TYPE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/swordnex_billing_dev

# Opaque data-partition key for every Mongo query. Keep it stable.
TENANT_ID=your_tenant_id

# Auth — use a long random string.
JWT_SECRET=your_super_secret_jwt_key_here

# Server
PORT=5003
NODE_ENV=development

# Where the frontend runs (used to build password-reset links)
FRONTEND_URL=http://localhost:5173

# Razorpay — leave blank to disable payments.
RAZORPAY_KEY_ID=rzp_test_Tds1ZAfao4BeCX
RAZORPAY_KEY_SECRET=NajR71Pvl7Oiznk8eHhU2Ow6
# Razorpay Dashboard > Webhooks (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# Brevo email — leave blank to disable email.
BREVO_API_KEY=
SENDER_EMAIL=noreply@example.com

# Super admin — single hardcoded platform-owner login for /superadmin.
# Not tied to any Owner/SubUser record. Set a strong password.
SUPERADMIN_EMAIL=admin@swordnex.com
SUPERADMIN_PASSWORD=Admin@2026

# Production (Firestore): set DB_TYPE=firestore above and provide the key for this project
FIREBASE_PROJECT_ID=swordnex-sites
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Free email option (OTP, receipts): a Gmail account + App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
