# Copy to .env.custom and fill in. .env.custom is git-ignored.

# Database — MongoDB only for now.
DB_TYPE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/swordnex_billing_dev

# Opaque data-partition key for every Mongo query. Keep it stable.
TENANT_ID=your_tenant_id

# Auth — use a long random string.
JWT_SECRET=your_super_secret_jwt_key_here

# Server
PORT=5003
NODE_ENV=development

# Where the frontend runs (used to build password-reset links)
FRONTEND_URL=http://localhost:5173

# Razorpay — leave blank to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Brevo email — leave blank to disable email.
BREVO_API_KEY=
SENDER_EMAIL=noreply@example.com
