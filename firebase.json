{
    "functions": [
        {
            "source": "backend",
            "codebase": "billing",
            "runtime": "nodejs22",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log",
                "*.local",
                "serviceAccountKey.json",
                ".env.custom",
                ".env.example",
                "temp",
                "kill_port.js"
            ]
        }
    ],
    "firestore": [
        {
            "database": "billing",
            "rules": "firestore.rules",
            "indexes": "firestore.indexes.json"
        }
    ],
    "hosting": [
        {
            "public": "frontend/dist",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cross-Origin-Opener-Policy",
                            "value": "unsafe-none"
                        },
                        {
                            "key": "Cross-Origin-Embedder-Policy",
                            "value": "unsafe-none"
                        }
                    ]
                }
            ],
            "rewrites": [
                {
                    "source": "/api/**",
                    "function": {
                        "functionId": "billingApi",
                        "region": "asia-south1"
                    }
                },
                {
                    "source": "**",
                    "destination": "/index.html"
                }
            ],
            "site": "swordnex-billing-app"
        }
    ]
}